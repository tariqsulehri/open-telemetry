# ==============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to '.env' and fill in your actual credentials.
# ==============================================================================

# --- Server Configuration ---
PORT=3500
NODE_ENV=development

# --- OpenTelemetry / Service Identity ---
# This name will appear in Grafana Service Map and Tempo Traces
OTEL_SERVICE_NAME=ecom.nodejs.user.service

# --- OTLP Endpoints ---
# Points to the OTel Collector. Use 'localhost' if running app on host, 
# or 'otel-collector' if running app inside the same Docker network.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- AWS Infrastructure (S3 Storage) ---
# Required for Loki (Logs) and Tempo (Traces) persistence
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1

# --- Storage Buckets ---
# Ensure these buckets exist in your AWS account before starting the stack
LOKI_S3_BUCKET=org-observability-loki-logs
TEMPO_S3_BUCKET=org-observability-tempo-traces

# --- Logging ---
# Endpoint for direct log shipping if not using the OTel Collector for logs
LOKI_ENDPOINT=http://localhost:3100/loki/api/v1/push