NODE_ENV=development
PORT=3500

# --- OpenTelemetry / Service Identity ---
OTEL_SERVICE_NAME=ecom.nodejs.user.service

#FIX: Point to the Collector on your Mac (localhost)
# Since your app is on the Mac, use localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- AWS Config ---
# Ensure these have values after the '=' sign
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Logging ---
# If your Node.js app sends logs directly to Loki, use localhost
LOKI_ENDPOINT=http://localhost:3100/loki/api/v1/push