server:
  http_listen_port: 3200

memberlist:
  abort_if_cluster_join_fails: false
  bind_port: 7946
  join_members: [127.0.0.1:7946]

metrics_generator:
  registry:
    external_labels:
      source: tempo
  storage:
    path: /var/tempo/generator/wal
  ring:
    kvstore:
      store: inmemory
  processor:
    local_blocks:
      filter_server_spans: false

distributor:
  receivers:
    otlp:
      protocols:
        grpc:
          endpoint: 0.0.0.0:4317
        http:
          endpoint: 0.0.0.0:4318

ingester:
  lifecycler:
    interface_names: ["eth0", "lo"]
    ring:
      replication_factor: 1
      kvstore:
        store: inmemory
    final_sleep: 0s

storage:
  trace:
    backend: s3
    s3:
      bucket: org-observability-tempo-traces
      endpoint: s3.us-east-1.amazonaws.com
      region: us-east-1
      access_key: ${AWS_ACCESS_KEY_ID}
      secret_key: ${AWS_SECRET_ACCESS_KEY}
    wal:
      path: /var/tempo/wal

overrides:
  defaults:
    ingestion:
      max_traces_per_user: 10000
    metrics_generator:
      processors: ['service-graphs', 'span-metrics', 'local-blocks']
